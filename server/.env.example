# PostgreSQL container settings
POSTGRES_DB=bimaverse
POSTGRES_USER=bimaverse_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: If set, this takes priority over individual POSTGRES_* values
# DATABASE_URL=postgresql+psycopg2://bimaverse_user:change_me@localhost:5432/bimaverse

# Document storage
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=uploads

# Auth / JWT
SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_SECRET_KEY=replace-with-a-separate-secure-refresh-secret
JWT_REFRESH_EXPIRE_DAYS=7
